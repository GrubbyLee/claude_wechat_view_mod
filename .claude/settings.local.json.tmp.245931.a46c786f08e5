{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(file:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(npx --yes @tarojs/cli@latest:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run dev:h5)",
      "Bash(npm run dev:h5:*)",
      "Bash(node bridges/:*)",
      "WebSearch",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
