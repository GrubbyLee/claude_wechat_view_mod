.container {
  padding: 40rpx;
}
.header {
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 0;
  color: #333333;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 32rpx;
  color: #1a1a1a;
  display: block;
}
.desc {
  font-size: 26rpx;
  color: #888888;
  display: block;
  margin-top: 12rpx;
}
.row {
  display: flex;
}
.box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}
.red { background: #e74c3c; }
.green { background: #2ecc71; }
.blue { background: #3498db; }
